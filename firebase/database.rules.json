{
  "rules": {
    ".read": false,
    ".write": false,
    "tickets": {
      "$room": {
        ".read": "$room.length >= 12 && $room.length <= 32",
        ".write": "$room.length >= 12 && $room.length <= 32",
        ".validate": "newData.hasChildren(['server', 'created'])",
        "server": { ".validate": "newData.isString() && newData.val().length <= 6" },
        "created": { ".validate": "newData.isNumber()" },
        "updated": { ".validate": "newData.isNumber()" },
        "people": {
          "$p": {
            ".validate": "$p.length <= 300 && newData.hasChildren(['name'])",
            "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "has": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
            "power": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000000000" },
            "pts": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10000000000000" },
            "order": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "presence": {
      "$room": {
        ".read": "$room.length >= 12 && $room.length <= 32",
        "$client": {
          ".write": "$room.length >= 12 && $room.length <= 32 && $client.length <= 32",
          ".validate": "newData.isNumber()"
        }
      }
    }
  }
}
